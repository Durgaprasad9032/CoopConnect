# CoopConnect Firebase Configuration
# If left empty, CoopConnect seamlessly runs in local offline Demo/Simulation mode,
# while providing complete role authentication, Google simulation, and Firestore state.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
